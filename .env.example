# ==============================================================================
# SEI MCP Server Configuration
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Security / Authentication for Gemini Enterprise / MCP Clients
# Set to true to enforce OAuth bearer token verification on tools/call requests
OAUTH_ENABLED=false
# Optional: Google OAuth 2.0 Client ID (for audience verification)
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# ==============================================================================
# SEI API Base URLs (Governo do Estado de São Paulo / Integrador SP)
# ==============================================================================
SEI_PROCESSOS_URL=https://sei-processos.api-hml.rota.sp.gov.br
SEI_DOCUMENTOS_URL=https://sei-documentos.api-hml.rota.sp.gov.br
SEI_PARAMETROS_URL=https://sei-parametros.api-hml.rota.sp.gov.br

# ==============================================================================
# IDP.SP / Rota.SP Authentication (OAuth 2.0 Client Credentials or Direct Bearer)
# ==============================================================================
# Option 1: Automatic OAuth2 Token retrieval using Client ID & Secret
IDPSP_TOKEN_URL=https://rhsso.idp-hml.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/token
IDPSP_CLIENT_ID=your-idpsp-client-id
IDPSP_CLIENT_SECRET=your-idpsp-client-secret

# Option 2: Direct Bearer Token (optional, if you already have a valid JWT token)
# SEI_BEARER_TOKEN=eyJhbGciOi...

# ==============================================================================
# SEI Required Request Headers
# ==============================================================================
# Sigla do Sistema cadastrado no SEI (fornecido pela equipe do SEI)
SEI_SIGLA_SISTEMA=INTEGRACAOCLIENTES

# Token de acesso do Sistema cadastrado no SEI (Chave de serviço fornecida pela equipe do SEI)
SEI_IDENTIFICACAO_SERVICO=your-service-token-hash

# ID da Unidade que executará as ações no SEI (ex: 110000384)
SEI_ID_UNIDADE=110000384

# Regional do Município (obrigatório apenas para SEI Cidades, ex: campinas. Deixar vazio para Estado)
# SEI_REGIONAL=
