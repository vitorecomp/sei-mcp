# ==============================================================================
# SEI MCP Server Configuration (Python / Standard SEI SOAP Web Services v3.1+)
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
ENV=development

# ==============================================================================
# Security / Authentication for Gemini Enterprise / MCP Clients
# ==============================================================================
# Set to true to enforce Google OAuth 2.0 Bearer token verification on tools/call
# (In production mode, OAUTH_ENABLED defaults to true unless explicitly set to false)
OAUTH_ENABLED=false

# Optional: Google OAuth 2.0 Client ID for token audience (aud) verification
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Optional: OAuth Discovery Metadata Overrides (/.well-known/*)
OAUTH_PROTECTED_RESOURCE=https://mcp-demo-sei.aidemo.space
OAUTH_AUTHORIZATION_SERVER=https://accounts.google.com

# ==============================================================================
# SEI Web Services SOAP Configuration (SEI-WebServices-v3.1.pdf)
# ==============================================================================
# Endpoint do Web Service SOAP do SEI:
# Formato padrão: https://[servidor_php]/sei/controlador_ws.php?servico=sei
# Ou atalho WS:   https://[servidor_php]/sei/ws/SeiWS.php
SEI_WS_URL=https://sei.orgao.gov.br/sei/controlador_ws.php?servico=sei

# Caminho local ou URL do arquivo WSDL do SEI
SEI_WSDL_PATH=sei-documentation/sei.wsdl

# Endpoint opcional do Web Service SOAP do SIP (Seção 4 - Serviços SIP: Permissões e Usuários)
# Formato padrão: https://[servidor_php]/sip/controlador_ws.php?servico=wsdl
SIP_WS_URL=https://sei.orgao.gov.br/sip/controlador_ws.php?servico=wsdl

# Endpoint opcional do Web Service de RH externo (Seção 5 - listarCargoFuncao)
RH_WS_URL=

# ==============================================================================
# SEI System Authentication Parameters (Administração > Sistemas > Serviços)
# ==============================================================================
# Sigla do Sistema cadastrado no menu Administração > Sistemas do SEI
SEI_SIGLA_SISTEMA=MEU_SISTEMA

# Identificação do Serviço cadastrada no menu Administração > Sistemas > Serviços
# (ou Chave de Acesso de 72 caracteres gerada no SEI 4.0+)
SEI_IDENTIFICACAO_SERVICO=your-sei-service-identification-or-access-key

# ID padrão da Unidade no SEI (ex: 110000001). Pode ser sobrescrito por chamada nas tools.
SEI_ID_UNIDADE=110000001

# ==============================================================================
# SOAP Transport & TLS Options
# ==============================================================================
# Codificação XML das requisições SOAP (UTF-8 ou ISO-8859-1)
SEI_SOAP_ENCODING=UTF-8

# Verificação de certificado SSL/TLS (true, false, ou caminho para bundle CA .pem)
SEI_VERIFY_SSL=true

# Timeout das requisições SOAP em segundos
SEI_TIMEOUT=60
