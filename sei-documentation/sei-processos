  parameters:
    xTraceIdSP:
      name: X-TraceId-SP
      in: header
      description: Identificador do request para localiza-lo na log do sistema. Preferencialmente
        utiliar um código único para cada request.
      required: true
      schema:
        type: string
      example: nome-da-aplicacao-data-hora-segundos
    xSiglaSistema:
      name: X-SiglaSistema
      in: header
      description: Sigla do Sistema cadastrado no SEI para permitir utilização do
        SOAP
      required: true
      schema:
        type: string
      example: INTEGRACAOCLIENTES
    xIdentificacaoServico:
      name: X-IdentificacaoServico
      in: header
      description: Token de acesso do Sistema cadastrado no SEI
      required: true
      schema:
        type: string
      example: 637f170e0a06056254adf2896c1d9f2fa668797ac6f6678bae9533487a07736003bfca44
    xIdUnidade:
      name: X-IdUnidade
      in: header
      description: ID da unidade que executará o serviço no SEI. Essa unidade aparecerá
        no andamento do processo como a unidade executora da operação.
      required: true
      schema:
        type: string
      example: "110000384"
    xRegional:
      name: X-Regional
      in: header
      description: Informar a regional do município (Obrigatório apenas para o sei-cidades)
      required: false
      schema:
        type: string
      example: campinas
    protocoloProcedimentoPath:
      name: protocoloProcedimento
      in: path
      description: "Número do processo visível para o usuário na interface do SEI.\
        \ Remover pontos, barras e hifens, deixar somente números. O exemplo abaixo\
        \ é referente ao processo 000.00000054/2026-12"
      required: true
      schema:
        type: string
      example: "00000000054202612"
    start:
      name: start
      in: query
      description: "Start e limit são utilizados para paginar o request, ou seja limitar\
        \ a quantidade trazida de itens na resposta. Start é o número da página desejada,\
        \ iniciando por 0; limit é a quantidade de itens trazida em cada página. <p>Por\
        \ exemplo: start=2 e limit=10 vai trazer os itens de 30 a 40 de uma pesquisa.\
        \ <p>O último item de cada página repete na próxima, então deve ser ignorado.<p>Recomenda-se\
        \ não exceder 100 itens por página para não impactar o SEI."
      schema:
        type: string
      example: "0"
    limit:
      name: limit
      in: query
      description: Quantidade de itens trazidos em uma página. Verifique o funcionamento
        no parâmetro start.
      schema:
        type: string
      example: "50"
  securitySchemes:
    IdpSP:
      type: http
      scheme: bearer
      bearerFormat: JWT
