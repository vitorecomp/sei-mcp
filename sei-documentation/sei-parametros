---
openapi: 3.0.3
info:
  title: sei-parametros API
  description: API de funções genéricas do sistema SEI
  version: 1.0.4
servers:
- url: https://sei-parametros.api-hml.rota.sp.gov.br
  description: Homologação
- url: http://localhost:8080/sei-parametros
  description: Teste Local
security:
- IdpSP: []
tags:
- name: cadastro
  description: "Cadastros de órgãos, unidades e usuários do sistema SEI"
- name: bloco
  description: Blocos internos e de assinatura
- name: úteis
  description: Serviços uteis
paths:
  /unidades:
    get:
      tags:
      - cadastro
      summary: Lista unidades
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xRegional'
      - name: IdTipoProcedimento
        in: query
        description: Id do tipo de Procedimento
        required: false
        schema:
          type: string
      - name: idSerie
        in: query
        description: Id do tipo de Documento (Serie documental)
        required: false
        schema:
          type: string
      - name: idOrgao
        in: query
        description: Id do Órgão
        required: false
        schema:
          type: string
      - name: siglaOrgao
        in: query
        description: Sigla do Órgão
        required: false
        schema:
          type: string
      - name: start
        in: query
        description: Recebe a página de inicio da paginação
        required: false
        schema:
          type: string
      - name: limit
        in: query
        description: Recebe o limite de registros da pagina
        required: false
        schema:
          type: string
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  Unidades:
                    type: array
                    items:
                      properties:
                        idUnidade:
                          description: Descrição da unidade
                          type: string
                        sigla:
                          description: Sigla da unidade
                          type: string
                        descricao:
                          description: Descrição da unidade
                          type: string
                        sinProtocolo:
                          description: S/N - indica se é uma unidade de protocolo
                          type: string
                        sinArquivamento:
                          description: S/N - indica se é uma unidade de arquivo
                          type: string
                        sinOuvidoria:
                          description: S/N - indica se é uma unidade de ouvidoria
                          type: string
                        orgao:
                          type: object
                          properties:
                            idOrgao:
                              description: Código identificado do órgão
                              type: string
                            sigla:
                              description: Sigla do órgão
                              type: string
                            descricao:
                              description: Descrição do órgão
                              type: string
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /usuarios:
    get:
      tags:
      - cadastro
      summary: Lista usuarios
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idUsuario
        in: query
        schema:
          type: string
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  usuarios:
                    $ref: '#/components/schemas/usuarios'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /replica-usuario:
    post:
      tags:
      - cadastro
      summary: Replicar usuario
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      requestBody:
        description: ""
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/replicarUsuarioRequest'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  ret:
                    type: boolean
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /tipos-conferencia:
    get:
      tags:
      - cadastro
      summary: Lista tipos de conferência
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  Tipos:
                    type: array
                    items:
                      properties:
                        idTipoConferencia:
                          description: Identificador do tipo de conferência
                          type: string
                        descricao:
                          description: Descrição do tipo de conferência
                          type: string
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /contatos:
    get:
      tags:
      - cadastro
      summary: Lista de contatos
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idTipoContato
        in: query
        description: ID do tipo de contato
        required: false
        schema:
          type: string
      - name: paginaRegistros
        in: query
        description: "Quantidade de itens por página retornada. Se não informado,\
          \ só traz um registro."
        required: false
        schema:
          type: integer
      - name: paginaAtual
        in: query
        description: Página a ser retornada (offset). Deve ser no mínimo 1.
        required: false
        schema:
          type: string
      - name: sigla
        in: query
        description: Sigla do usuário
        required: false
        schema:
          type: string
      - name: nome
        in: query
        description: Nome do usuário para pesquisa
        required: false
        schema:
          type: string
      - name: cpf
        in: query
        description: CPF do usuário para pesquisa
        required: false
        schema:
          type: string
      - name: matricula
        in: query
        description: Matricula do usuário para pesquisa
        required: false
        schema:
          type: string
      - name: idContatos
        in: query
        description: Lista de idContatos separados por vírgula para pesquisa
        required: false
        schema:
          type: string
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/contato'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
    post:
      tags:
      - cadastro
      summary: Inclusão de contatos
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      requestBody:
        description: "Parâmetros para criação de contatos. Pode ser criado mais de\
          \ um por vez. Se informado o idContato, vai processar como uma alteraçã\
          o, senão será uma inclusão."
        content:
          application/json:
            schema:
              type: array
              items:
                $ref: '#/components/schemas/contatoBody'
        required: true
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/contato'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /contatos/{idContato}:
    delete:
      tags:
      - cadastro
      summary: "Exclusão, Desativação e Reativação de contatos"
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idContato'
      - $ref: '#/components/parameters/staOperacao'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/contato'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /blocos/{idBloco}:
    get:
      tags:
      - bloco
      summary: Lista Blocos de assinatura e internos
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      - name: sinRetornarProtocolos
        in: query
        description: Retorna os processos incluídos no bloco. S - Sim / N - Não (default)
        required: true
        schema:
          default: "N"
          enum:
          - S
          - "N"
          type: string
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
    delete:
      tags:
      - bloco
      summary: Exclui um Bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      - name: sinRetornarProtocolos
        in: query
        description: Retorna os processos incluídos no bloco. S - Sim / N - Não (default)
        required: true
        schema:
          default: "N"
          enum:
          - S
          - "N"
          type: string
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /blocos/{idBloco}/disponibilizacao:
    post:
      tags:
      - bloco
      summary: Disponibiliza bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
    delete:
      tags:
      - bloco
      summary: Cancela disponibilização de bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /blocos/{idBloco}/documentos/{protocoloDocumento}:
    post:
      tags:
      - bloco
      summary: Inclui documento em um bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      - $ref: '#/components/parameters/protocoloDocumento'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/anotacaoBody'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
    delete:
      tags:
      - bloco
      summary: Remove documento de um bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      - $ref: '#/components/parameters/protocoloDocumento'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /blocos/{idBloco}/processos/{protocoloProcedimento}:
    post:
      tags:
      - bloco
      summary: Inclui processo em um bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      - $ref: '#/components/parameters/protocoloProcedimento'
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/anotacaoBody'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
    delete:
      tags:
      - bloco
      summary: Remove processo de um bloco
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - $ref: '#/components/parameters/idBloco'
      - $ref: '#/components/parameters/protocoloProcedimento'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/bloco'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /cargos:
    get:
      tags:
      - úteis
      summary: Lista Cargos
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idCargo
        in: query
        description: Retorna o cargo a partir de um idCargo informado
        required: false
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/cargo'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /cidades:
    get:
      tags:
      - úteis
      summary: Lista Cidades
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idPais
        in: query
        description: Retorna as cidades a partir de um idPais informado
        required: true
        schema:
          type: integer
      - name: idEstado
        in: query
        description: Retorna as cidades a partir de um idEstado informado
        required: true
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/cidade'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /estados:
    get:
      tags:
      - úteis
      summary: Lista estados
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idPais
        in: query
        description: Retorna os estados a partir de um idPais informado
        required: true
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/estado'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /extensoes:
    get:
      tags:
      - úteis
      summary: Lista extensões permitidas
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idArquivoExtensao
        in: query
        description: Identificador interno de uma extensão de arquivo
        required: false
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/extensao'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /feriados:
    get:
      tags:
      - úteis
      summary: Lista feriados
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idOrgao
        in: query
        description: Identificador do órgão associado com os feriados
        required: true
        schema:
          type: integer
      - name: dataInicial
        in: query
        description: Data inicial para filtro
        required: true
        schema:
          type: integer
      - name: dataFinal
        in: query
        description: Data final para filtro
        required: true
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/feriado'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /paises:
    get:
      tags:
      - úteis
      summary: Lista países
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/pais'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /series:
    get:
      tags:
      - úteis
      summary: Lista séries
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: idTipoProcedimento
        in: query
        description: Identificador do tipo de procedimento
        required: false
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/serie'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /hipoteses:
    get:
      tags:
      - úteis
      summary: Lista hipoteses Legais com nível de acesso
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: nivelAcesso
        in: query
        description: Identificador do nivel de acesso (1 - Restrito / 2 - Sigiloso)
        required: false
        schema:
          type: integer
      responses:
        "200":
          description: Executado com sucesso
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/hipotese'
        "400":
          $ref: '#/components/responses/erro400'
        "500":
          $ref: '#/components/responses/erro500'
  /assuntos:
    get:
      tags:
      - úteis
      summary: Lista assuntos
      parameters:
      - $ref: '#/components/parameters/xTraceIdSP'
      - $ref: '#/components/parameters/xSiglaSistema'
      - $ref: '#/components/parameters/xIdentificacaoServico'
      - $ref: '#/components/parameters/xIdUnidade'
      - $ref: '#/components/parameters/xRegional'
      - name: palavrasPesquisa
        in: query
        description: Recebe a palavra chave da pesquisa
        required: false
        schema:
