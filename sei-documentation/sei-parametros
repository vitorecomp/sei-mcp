      type: object
      properties:
        to:
          title: To
          default: ""
          pattern: "^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$"
          type: string
        from:
          title: From
          default: ""
          pattern: "^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$"
          type: string
        subject:
          title: Subject
          default: ""
          pattern: ^(?!\s*$).+
          type: string
        content:
          title: Content
          default: ""
          pattern: ^(?!\s*$).+
          type: string
        attachment:
          title: Attachment
          default: []
          type: array
          items:
            title: Items
            required:
            - name
            - type
            - data
            type: object
            properties:
              name:
                title: Name
                default: ""
                pattern: ^(?!\s*$).+
                type: string
              type:
                title: Type
                default: ""
                pattern: ^(?!\s*$).+
                type: string
